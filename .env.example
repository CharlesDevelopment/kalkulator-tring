# Konfigurasi Endpoint Harga Emas Pegadaian (Opsional)
# Secara default aplikasi mengambil harga resmi langsung dari endpoint publik Pegadaian / Galeri24 / Logam Mulia
# Jika Anda memiliki proxy API atau custom scraper endpoint sendiri, masukkan URL-nya di bawah ini:
PEGADAIAN_PRICE_API_URL=https://sahabat.pegadaian.co.id/gold/prices

# Timeout request harga realtime dalam milidetik (Default: 6000)
PRICE_FETCH_TIMEOUT_MS=6000
